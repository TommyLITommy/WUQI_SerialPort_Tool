<Window x:Class="MySerialPortAssistant04.MagnetometerSubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁力计指南针" Height="540" Width="420"
        KeyDown="Window_KeyDown" Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 父窗口标识栏 -->
        <Border Grid.Row="0" Background="#FF007ACC" CornerRadius="3" Margin="5 5 5 5" Padding="5 2">
            <TextBlock x:Name="TxtParentInfo" 
                       Text="所属串口: #1" 
                       Foreground="White" 
                       FontWeight="Bold"
                       FontSize="12"/>
        </Border>

        <!-- 指南针画布 -->
        <Canvas x:Name="CompassCanvas" Grid.Row="1" Width="300" Height="300" 
                HorizontalAlignment="Center" Background="White"/>

        <!-- 显示模式选择 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <CheckBox x:Name="ModeCheckBox" Content="方案B：指针旋转（传统指南针）" 
                      Checked="ModeCheckBox_CheckedChanged" 
                      Unchecked="ModeCheckBox_CheckedChanged"
                      FontSize="11"/>
        </StackPanel>

        <!-- 控制按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <ToggleButton x:Name="ToggleBtn" Content="暂停" Click="ToggleBtn_Click" 
                          Width="80" Margin="5"/>
            <Button Content="重置" Click="ResetBtn_Click" Width="80" Margin="5"/>
            <Button x:Name="DemoBtn" Content="演示: 关" Click="DemoBtn_Click" 
                    Width="80" Margin="5"/>
        </StackPanel>

        <!-- 状态显示 -->
        <TextBlock x:Name="StatusLabel" Grid.Row="4" Text="角度: 0.0° | FPS: -- | 模式: 方案A" 
                   HorizontalAlignment="Center" FontSize="12"/>

        <!-- 操作提示 -->
        <TextBlock Grid.Row="5" Text="方向键手动控制 | 演示模式自动旋转 | 实时模式接收日志数据"
                   HorizontalAlignment="Center" Foreground="Gray" FontSize="10" Margin="5"/>
    </Grid>
</Window>