<Window x:Class="MySerialPortAssistant04.WaveformSubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="波形图窗口" Height="650" Width="1250" Background="#FF1A1A1A">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Grid.Column="0" Background="#FF007ACC" CornerRadius="3" Margin="0 0 5 5" Padding="6 3">
            <TextBlock x:Name="TxtParentInfo" Text="所属串口: #1" Foreground="White" FontWeight="Bold" FontSize="13"/>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Grid.Column="0" Background="#FF2D2D30" CornerRadius="3" Margin="0 0 5 5" Padding="8 6">
            <StackPanel Orientation="Horizontal">
                <!-- 模式选择 -->
                <TextBlock Text="模式:" Foreground="#FFAAAAAA" FontSize="12" VerticalAlignment="Center" Margin="0 0 5 0"/>
                <ComboBox x:Name="CmbMode" Width="150" FontSize="12" Margin="0 0 15 0"
                          SelectedIndex="0" SelectionChanged="CmbMode_SelectionChanged">
                    <ComboBoxItem Content="Same_angle (角度)"/>
                    <ComboBoxItem Content="FIFO xyz (原始值)"/>
                </ComboBox>

                <CheckBox x:Name="ChkX" Content="显示 X (红)" Foreground="#FFEA4C4C" IsChecked="True" Margin="0 0 15 0" FontSize="12"/>
                <CheckBox x:Name="ChkY" Content="显示 Y (绿)" Foreground="#FF4EC94E" IsChecked="True" Margin="0 0 15 0" FontSize="12"/>
                <CheckBox x:Name="ChkZ" Content="显示 Z (蓝)" Foreground="#FF4D9EFF" IsChecked="True" Margin="0 0 20 0" FontSize="12"/>

                <Button x:Name="BtnPlayPause" Content="⏸ 暂停" Click="BtnPlayPause_Click" 
                        FontSize="12" Padding="10 4" Margin="0 0 10 0"
                        Background="#FF4EC94E" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                <Button x:Name="BtnClear" Content="清空波形" Click="BtnClear_Click" 
                        FontSize="12" Padding="8 4" Margin="0 0 15 0"
                        Background="#FF3E3E42" Foreground="White" BorderThickness="0"/>

                <TextBlock x:Name="TxtStatus" Text="实时模式" Foreground="#FFAAAAAA" FontSize="12" 
                           VerticalAlignment="Center" Margin="10 0 0 0"/>
            </StackPanel>
        </Border>

        <!-- 波形画布区域 - 左中右三栏布局 -->
        <Border Grid.Row="2" Grid.Column="0" Margin="0 5 5 5" Background="Black" CornerRadius="2">
            <Grid>
                <!-- 左侧Y轴刻度 -->
                <Canvas x:Name="YAxisCanvas" Width="50" HorizontalAlignment="Left"/>

                <!-- 中间波形画布 -->
                <Border x:Name="WaveBorder" Background="Transparent" Margin="50 0 50 0">
                    <Canvas x:Name="WaveCanvas" Background="Transparent" ClipToBounds="True"/>
                </Border>

                <!-- 右侧Y轴刻度 -->
                <Canvas x:Name="YAxisRightCanvas" Width="50" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 底部控制栏 -->
        <Border Grid.Row="3" Grid.Column="0" Background="#FF2D2D30" CornerRadius="3" Margin="0 5 5 0" Padding="10 8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtTimeInfo" Grid.Column="0" Text="00:00 / 05:00" 
                           Foreground="#FFCCCCCC" FontSize="12" VerticalAlignment="Center" 
                           Margin="0 0 15 0" Width="110"/>

                <Slider x:Name="SliderHistory" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                        TickFrequency="1" IsSnapToTickEnabled="False"
                        VerticalAlignment="Center" Margin="0 0 15 0"
                        Thumb.DragStarted="SliderHistory_DragStarted"
                        Thumb.DragCompleted="SliderHistory_DragCompleted"
                        ValueChanged="SliderHistory_ValueChanged"/>

                <TextBlock Grid.Column="2" Text="时间缩放:" Foreground="#FFAAAAAA" 
                           FontSize="12" VerticalAlignment="Center" Margin="0 0 8 0"/>
                <ComboBox x:Name="CmbTimeScale" Grid.Column="3" Width="80" FontSize="12"
                          SelectedIndex="0" SelectionChanged="CmbTimeScale_SelectionChanged">
                    <ComboBoxItem Content="1x"/>
                    <ComboBoxItem Content="2x"/>
                    <ComboBoxItem Content="5x"/>
                    <ComboBoxItem Content="10x"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 右侧实时数据显示面板 -->
        <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" 
                Background="#FF252526" CornerRadius="3" 
                Width="160" Margin="5 0 0 0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 面板标题 -->
                <Border Grid.Row="0" Background="#FF007ACC" CornerRadius="2" Padding="8 5" Margin="0 0 0 15">
                    <TextBlock Text="实时数值" Foreground="White" FontWeight="Bold" 
                               FontSize="14" HorizontalAlignment="Center"/>
                </Border>

                <!-- X 值显示 -->
                <Border Grid.Row="1" Background="#FF3E3E42" CornerRadius="3" Padding="10" Margin="0 0 0 10">
                    <StackPanel>
                        <TextBlock x:Name="TxtLabelX" Text="X 轴 (红色)" Foreground="#FFEA4C4C" FontSize="11" 
                                   FontWeight="Bold" Margin="0 0 0 5"/>
                        <TextBlock x:Name="TxtRealTimeX" Text="0" Foreground="White" 
                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Y 值显示 -->
                <Border Grid.Row="2" Background="#FF3E3E42" CornerRadius="3" Padding="10" Margin="0 0 0 10">
                    <StackPanel>
                        <TextBlock x:Name="TxtLabelY" Text="Y 轴 (绿色)" Foreground="#FF4EC94E" FontSize="11" 
                                   FontWeight="Bold" Margin="0 0 0 5"/>
                        <TextBlock x:Name="TxtRealTimeY" Text="0" Foreground="White" 
                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Z 值显示 -->
                <Border Grid.Row="3" Background="#FF3E3E42" CornerRadius="3" Padding="10" Margin="0 0 0 10">
                    <StackPanel>
                        <TextBlock x:Name="TxtLabelZ" Text="Z 轴 (蓝色)" Foreground="#FF4D9EFF" FontSize="11" 
                                   FontWeight="Bold" Margin="0 0 0 5"/>
                        <TextBlock x:Name="TxtRealTimeZ" Text="0" Foreground="White" 
                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 说明文字 -->
                <Border Grid.Row="4" Background="#FF1E1E1E" CornerRadius="2" Padding="8" 
                        VerticalAlignment="Bottom">
                    <TextBlock x:Name="TxtHint" Text="显示原始角度值&#x0a;(0-360°范围)" 
                               Foreground="#FF888888" FontSize="10" 
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>