<UserControl x:Class="MySerialPortAssistant04.SerialPortMonitorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#FF007ACC" BorderThickness="2" CornerRadius="5" Background="White">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：显示序号和关闭按钮 -->
            <Grid Grid.Row="0" Background="#FF007ACC" Margin="-10,-10,-10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTitle" 
                           Text="串口监控 #1" 
                           Foreground="White" 
                           FontWeight="Bold" 
                           FontSize="14"
                           VerticalAlignment="Center" 
                           Margin="10,5"/>
                <Button x:Name="BtnClose" 
                        Grid.Column="1" 
                        Content="✕" 
                        Width="30" 
                        Height="25"
                        Margin="0,0,5,0"
                        Background="#FFC75450" 
                        Foreground="White" 
                        BorderThickness="0"
                        Click="BtnClose_Click"
                        ToolTip="关闭此串口监控"/>
            </Grid>

            <!-- 日志文件配置 - 关键修复：使用 TextBlock 替代 TextBox，支持 TextTrimming -->
            <GroupBox Header="日志文件配置（全局共用）" Grid.Row="1" Margin="0 0 0 5" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="日志文件：" VerticalAlignment="Center"/>

                    <!-- 关键修复：改用 TextBlock，支持 TextTrimming -->
                    <TextBlock x:Name="TxtLogPath" 
                               Grid.Column="1" 
                               Margin="5 0" 
                               VerticalAlignment="Center" 
                               FontSize="12"
                               Text="等待主窗口设置..."
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                    <!-- 状态指示器 -->
                    <Border Grid.Column="2" 
                            Background="#FFF0F0F0" 
                            CornerRadius="3" 
                            Padding="8,3" 
                            Margin="2,0" 
                            BorderBrush="#FFCCCCCC" 
                            BorderThickness="1">
                        <TextBlock x:Name="TxtLogStatus" Text="未设置" Foreground="Gray" FontSize="12"/>
                    </Border>
                </Grid>
            </GroupBox>

            <!-- 串口控制 -->
            <GroupBox Header="串口控制" Grid.Row="2" Margin="0 0 0 5" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="串口号：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CboSerialPort" Grid.Column="1" Margin="5 0" VerticalAlignment="Center"/>

                    <!-- HCI 发送方式选择 -->
                    <Label Content="发送方式：" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <ComboBox x:Name="CboHciSendMode" Grid.Column="3" Margin="5 0" VerticalAlignment="Center">
                        <ComboBoxItem Content="命名管道(Wireshark)" IsSelected="True"/>
                        <ComboBoxItem Content="UDP(Ellisys)"/>
                    </ComboBox>

                    <!-- UDP 目标地址 -->
                    <TextBox x:Name="TxtUdpTarget" Grid.Column="4" Width="130" Margin="5 0" VerticalAlignment="Center"
                             Text="127.0.0.1:24352" ToolTip="UDP 目标 IP:端口"/>

                    <Button x:Name="BtnStartMonitor" Grid.Column="5" Content="启动监听" Width="80"
                            Click="BtnStartMonitor_Click" Margin="5 0"/>
                    <Button x:Name="BtnStopMonitor" Grid.Column="6" Content="停止监听" Width="80"
                            Click="BtnStopMonitor_Click" IsEnabled="False" Margin="5 0"/>
                </Grid>
            </GroupBox>

            <!-- 实时统计 -->
            <GroupBox Header="实时统计" Grid.Row="3" Margin="0 0 0 5" Padding="8">
                <WrapPanel>
                    <TextBlock Text="接收总数：" Margin="0 0 10 0"/>
                    <TextBlock x:Name="TxtReceived" Text="0" Margin="0 0 15 0" Foreground="Blue"/>
                    <TextBlock Text="解析成功：" Margin="0 0 10 0"/>
                    <TextBlock x:Name="TxtParsed" Text="0" Margin="0 0 15 0" Foreground="Green"/>
                    <TextBlock Text="丢弃总数：" Margin="0 0 10 0"/>
                    <TextBlock x:Name="TxtDropped" Text="0" Margin="0 0 15 0" Foreground="Red"/>
                    <TextBlock Text="序列号间隙：" Margin="0 0 10 0"/>
                    <TextBlock x:Name="TxtGap" Text="0" Margin="0 0 15 0"/>
                    <TextBlock Text="缓冲区大小：" Margin="0 0 10 0"/>
                    <TextBlock x:Name="TxtBuffer" Text="0" Margin="0 0 15 0"/>
                    <TextBlock Text="HCI状态：" Margin="0 0 10 0"/>
                    <TextBlock x:Name="TxtPipeStatus" Text="未启动" Margin="0 0 15 0" Foreground="Purple"/>
                </WrapPanel>
            </GroupBox>

            <!-- 实时日志 -->
            <GroupBox Header="实时日志" Grid.Row="4" Margin="0 0 0 5">
                <TextBox x:Name="TxtLogOutput" 
                         IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" 
                         FontSize="12" 
                         Background="Black" 
                         Foreground="White"
                         Margin="2" 
                         AcceptsReturn="True" 
                         TextWrapping="NoWrap"/>
            </GroupBox>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 5">
                <ComboBox x:Name="CboSubWindowType" Width="120" Margin="2">
                    <ComboBoxItem Content="过滤日志窗口" IsSelected="True"/>
                    <ComboBoxItem Content="波形图窗口"/>
                    <ComboBoxItem Content="磁力计方位窗口"/>
                    <ComboBoxItem Content="姿态窗口"/>
                </ComboBox>
                <Button Content="打开子窗口" Width="90" Click="BtnOpenSelectedSubWindow_Click" Margin="2"/>
                <Button x:Name="BtnClearLog" Content="清空日志" Width="80" Click="BtnClearLog_Click" Margin="2"/>
                <Button x:Name="BtnRefreshPort" Content="刷新串口" Width="80" Click="BtnRefreshPort_Click" Margin="2"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>