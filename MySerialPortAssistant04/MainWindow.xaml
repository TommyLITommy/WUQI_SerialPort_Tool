<Window x:Class="MySerialPortAssistant04.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySerialPortAssistant04"
        Title="多串口监控系统" Height="1000" Width="1800"
        MinWidth="900" MinHeight="500"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Background="#FF3F3F46">
            <Button x:Name="btnAdd" Content="➕ 添加串口" 
                    Click="BtnAdd_Click" 
                    Padding="10,5" Margin="5"
                    Background="#FF007ACC" Foreground="White"/>
            <Button x:Name="btnRemove" Content="➖ 移除串口" 
                    Click="BtnRemove_Click" 
                    Padding="10,5" Margin="5"
                    Background="#FFC75450" Foreground="White"/>
            <Separator Margin="10,0"/>

            <!-- 总开关按钮：一键控制所有串口的开启/关闭 -->
            <Button x:Name="btnMasterToggle" Content="▶ 全部开启" 
                    Click="BtnMasterToggle_Click" 
                    Padding="10,5" Margin="5"
                    Background="#FF4CAF50" Foreground="White"
                    FontWeight="Bold"
                    ToolTip="一键开启或关闭所有串口的监听"/>
            <Separator Margin="10,0"/>

            <Button x:Name="btnSelectLog" Content="📄 选择日志文件" 
                    Click="BtnSelectLog_Click" 
                    Padding="10,5" Margin="5"
                    Background="#FF4CAF50" Foreground="White"
                    ToolTip="选择所有串口共用的日志文件"/>
            <Separator Margin="10,0"/>
            <TextBlock x:Name="txtStatus" 
                       Text="当前: 0个串口" 
                       Foreground="White" 
                       VerticalAlignment="Center" Margin="10,0"/>
        </ToolBar>

        <!-- 关键修复：HorizontalScrollBarVisibility="Disabled" 防止滚动条出现 -->
        <!-- 这样 Grid 会被限制在可视区域内，GridSplitter 可以正常工作 -->
        <ScrollViewer x:Name="mainScrollViewer" 
                      Grid.Row="1" 
                      Margin="5" 
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="portsContainer" Background="#FF2D2D30">
                <!-- 动态生成列定义和 GridSplitter -->
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>