<Window x:Class="MySerialPortAssistant04.FilterLogSubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="过滤日志窗口" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 父窗口标识栏 -->
        <Border Grid.Row="0" Background="#FF007ACC" CornerRadius="4" Margin="0 0 0 10" Padding="8 4">
            <TextBlock x:Name="TxtParentInfo" 
                       Text="所属串口: #1" 
                       Foreground="White" 
                       FontWeight="SemiBold"
                       FontSize="13"/>
        </Border>

        <!-- 过滤控制栏 - 使用Grid实现精确对齐 -->
        <Border Grid.Row="1" 
                Background="#FFF5F5F5" 
                BorderBrush="#FFD0D0D0" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="10 8" 
                Margin="0 0 0 10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 关键词输入框 -->
                <TextBox x:Name="TxtKeyword" 
                         Grid.Column="0"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Padding="8 0"
                         Margin="0 0 10 0">
                    <TextBox.Resources>
                        <VisualBrush x:Key="WatermarkBrush" 
                                     AlignmentX="Left" 
                                     AlignmentY="Center" 
                                     Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="输入关键词过滤..." 
                                           Foreground="#FF999999" 
                                           Margin="8 0 0 0"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="#FFC0C0C0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource WatermarkBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- 启用正则 -->
                <CheckBox x:Name="CbEnableRegex" 
                          Grid.Column="1"
                          Content="启用正则表达式" 
                          Margin="0 0 15 0"
                          VerticalAlignment="Center"
                          FontSize="12"/>

                <!-- 应用过滤按钮 -->
                <Button Grid.Column="2" 
                        Content="应用过滤" 
                        Click="BtnFilter_Click" 
                        Height="28"
                        Width="80"
                        Margin="0 0 8 0"
                        Background="#FF007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="3"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF005A9E"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#FF004578"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 清空按钮 -->
                <Button Grid.Column="3" 
                        Content="清空" 
                        Click="BtnClear_Click" 
                        Height="28"
                        Width="60"
                        Background="White"
                        BorderBrush="#FFC0C0C0"
                        BorderThickness="1"
                        FontSize="12">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="3"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFE8E8E8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#FFD0D0D0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- 日志显示 -->
        <Border Grid.Row="2" 
                BorderBrush="#FFD0D0D0" 
                BorderThickness="1" 
                CornerRadius="4">
            <RichTextBox x:Name="TxtLog" 
                         IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" 
                         FontSize="12" 
                         Background="#FF1E1E1E" 
                         Foreground="#FFD4D4D4"
                         BorderThickness="0"
                         Padding="5"/>
        </Border>
    </Grid>
</Window>