<!-- Attitude3DWindow.xaml -->
<Window x:Class="MySerialPortAssistant04.Attitude3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D 姿态可视化" Height="700" Width="1100" 
        Background="#FF1A1A1A" WindowStartupLocation="CenterOwner">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Grid.Column="0" Background="#FF007ACC" CornerRadius="3" Margin="0 0 5 5" Padding="6 3">
            <TextBlock x:Name="TxtParentInfo" Text="所属串口: #1" Foreground="White" FontWeight="Bold" FontSize="13"/>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Grid.Column="0" Background="#FF2D2D30" CornerRadius="3" Margin="0 0 5 5" Padding="8 6">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkShowGrid" Content="显示网格" Foreground="#FFAAAAAA" IsChecked="True" 
                          Margin="0 0 15 0" FontSize="12" Checked="ChkShowGrid_Checked" Unchecked="ChkShowGrid_Unchecked"/>
                <CheckBox x:Name="ChkShowAxes" Content="显示坐标轴" Foreground="#FFAAAAAA" IsChecked="True" 
                          Margin="0 0 15 0" FontSize="12" Checked="ChkShowAxes_Checked" Unchecked="ChkShowAxes_Unchecked"/>
                <CheckBox x:Name="ChkAutoRotate" Content="自动旋转视角" Foreground="#FFAAAAAA" IsChecked="False" 
                          Margin="0 0 15 0" FontSize="12" Checked="ChkAutoRotate_Checked" Unchecked="ChkAutoRotate_Unchecked"/>

                <Button x:Name="BtnResetView" Content="重置视角" Click="BtnResetView_Click" 
                        FontSize="12" Padding="10 4" Margin="0 0 10 0"
                        Background="#FF3E3E42" Foreground="White" BorderThickness="0"/>

                <Button x:Name="BtnResetAttitude" Content="姿态归零" Click="BtnResetAttitude_Click" 
                        FontSize="12" Padding="10 4" Margin="0 0 15 0"
                        Background="#FF4EC94E" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                <TextBlock x:Name="TxtStatus" Text="实时模式" Foreground="#FFAAAAAA" FontSize="12" 
                           VerticalAlignment="Center" Margin="10 0 0 0"/>
            </StackPanel>
        </Border>

        <!-- 3D 画布区域 -->
        <Border Grid.Row="2" Grid.Column="0" Margin="0 5 5 5" Background="#FF0A0A0A" CornerRadius="2">
            <Grid>
                <!-- 主画布 -->
                <Image x:Name="AttitudeImage" Stretch="None" 
                       MouseMove="AttitudeImage_MouseMove"
                       MouseDown="AttitudeImage_MouseDown"
                       MouseUp="AttitudeImage_MouseUp"
                       MouseWheel="AttitudeImage_MouseWheel"/>

                <!-- 中心十字准星 -->
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                    <Line x:Name="CrossH" X1="0" Y1="0" X2="0" Y2="0" 
                          Stroke="#FF333333" StrokeThickness="1" StrokeDashArray="4,4"/>
                    <Line x:Name="CrossV" X1="0" Y1="0" X2="0" Y2="0" 
                          Stroke="#FF333333" StrokeThickness="1" StrokeDashArray="4,4"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Grid.Column="0" Background="#FF2D2D30" CornerRadius="3" Margin="0 5 5 0" Padding="10 8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtFpsInfo" Grid.Column="0" Text="FPS: 60" 
                           Foreground="#FFCCCCCC" FontSize="12" VerticalAlignment="Center" 
                           Margin="0 0 15 0" Width="80"/>

                <TextBlock x:Name="TxtDataInfo" Grid.Column="1" Text="数据计数: 0 | 最后更新: --" 
                           Foreground="#FFAAAAAA" FontSize="12" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="拖动旋转 | 滚轮缩放 | 右键平移" 
                           Foreground="#FF666666" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 右侧实时数据显示面板 -->
        <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" 
                Background="#FF252526" CornerRadius="3" 
                Width="180" Margin="5 0 0 0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 面板标题 -->
                <Border Grid.Row="0" Background="#FF007ACC" CornerRadius="2" Padding="8 5" Margin="0 0 0 15">
                    <TextBlock Text="实时姿态" Foreground="White" FontWeight="Bold" 
                               FontSize="14" HorizontalAlignment="Center"/>
                </Border>

                <!-- Roll X -->
                <Border Grid.Row="1" Background="#FF3E3E42" CornerRadius="3" Padding="10" Margin="0 0 0 10">
                    <StackPanel>
                        <TextBlock Text="Yaw (X) 偏航" Foreground="#FFEA4C4C" FontSize="11" 
                                   FontWeight="Bold" Margin="0 0 0 5"/>
                        <TextBlock x:Name="TxtRoll" Text="0°" Foreground="White" 
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="BarRoll" Height="4" Margin="0 5 0 0" 
                                     Maximum="360" Value="180" Foreground="#FFEA4C4C" 
                                     Background="#FF1E1E1E" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Pitch Y -->
                <Border Grid.Row="2" Background="#FF3E3E42" CornerRadius="3" Padding="10" Margin="0 0 0 10">
                    <StackPanel>
                        <TextBlock Text="Roll (Y) 横滚" Foreground="#FF4EC94E" FontSize="11" 
                                   FontWeight="Bold" Margin="0 0 0 5"/>
                        <TextBlock x:Name="TxtPitch" Text="0°" Foreground="White" 
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="BarPitch" Height="4" Margin="0 5 0 0" 
                                     Maximum="360" Value="180" Foreground="#FF4EC94E" 
                                     Background="#FF1E1E1E" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Yaw Z -->
                <Border Grid.Row="3" Background="#FF3E3E42" CornerRadius="3" Padding="10" Margin="0 0 0 10">
                    <StackPanel>
                        <TextBlock Text="Pitch (Z) 俯仰" Foreground="#FF4D9EFF" FontSize="11" 
                                   FontWeight="Bold" Margin="0 0 0 5"/>
                        <TextBlock x:Name="TxtYaw" Text="0°" Foreground="White" 
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="BarYaw" Height="4" Margin="0 5 0 0" 
                                     Maximum="360" Value="180" Foreground="#FF4D9EFF" 
                                     Background="#FF1E1E1E" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- 3D 视角信息 -->
                <Border Grid.Row="4" Background="#FF1E1E1E" CornerRadius="2" Padding="8" Margin="0 0 0 10">
                    <StackPanel>
                        <TextBlock Text="视角信息" Foreground="#FF888888" FontSize="10" 
                                   Margin="0 0 0 5" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtCameraInfo" Text="距离: 8.0&#x0a;俯仰: 45°&#x0a;水平: 45°" 
                                   Foreground="#FFAAAAAA" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 说明 -->
                <Border Grid.Row="5" Background="#FF1E1E1E" CornerRadius="2" Padding="8" 
                        VerticalAlignment="Bottom">
                    <TextBlock Text="红色=机头(X)&#x0a;绿色=机尾&#x0a;蓝色=机翼&#x0a;黄色=姿态线" 
                               Foreground="#FF888888" FontSize="10" 
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>